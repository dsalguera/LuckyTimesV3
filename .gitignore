# ==========================================
# LuckyTimes Modern - .gitignore
# Node.js + Next.js + TypeScript + Prisma
# ==========================================

# Dependencies
node_modules/
.pnp/
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Next.js
.next/
out/
build/
dist/

# Production
.vercel/
.netlify/

# Environment variables
.env
.env.*
!.env.example
!.env.local.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo

# Testing
coverage/
.nyc_output/
playwright-report/
test-results/

# Temporary files
tmp/
temp/
.cache/
*.tmp

# Operating systems
.DS_Store
Thumbs.db
Desktop.ini

# IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Prisma
prisma/*.db
prisma/*.db-journal
*.sqlite
*.sqlite3

# Local database backups
*.sql.gz
backups/
database-backups/

# Local uploads
uploads/
public/uploads/

# Local secrets
*.pem
*.key
*.p12
*.pfx

# Miscellaneous
*.bak
*.backup